# Local development only. No AI key is required for accounts and database storage.
ZYRA_BACKEND_PORT=4310
# Optional: omit to use data/zyra.sqlite in this project.
# ZYRA_DATABASE_PATH=C:/your/private/path/zyra.sqlite

# Shared cloud deployment: put these ONLY in Vercel server settings (never VITE_*).
# GROQ_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# ZYRA_SESSION_SECRET=  # generated once; preserve for existing encrypted backups
# ZYRA_DAILY_LIMIT=20
# ZYRA_GLOBAL_DAILY_LIMIT=200
# ZYRA_APP_ID=jyra
# Optional support sender:
# ZYRA_SUPPORT_TO=
# ZYRA_SUPPORT_FROM=
# ZYRA_SUPPORT_SMTP_HOST=
# ZYRA_SUPPORT_SMTP_USER=
# ZYRA_SUPPORT_SMTP_PASSWORD=
# ZYRA_SUPPORT_SMTP_PORT=465
