{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JYRA AI",
  "version": "0.1.0",
  "identifier": "com.zyra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:all",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "JYRA AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/dist/": "resources/dist/",
      "resources/server/": "resources/server/",
      "resources/scripts/": "resources/scripts/",
      "resources/runtime/": "resources/runtime/",
      "resources/node.exe": "resources/node.exe",
      "resources/models/ggml-base.bin": "resources/models/ggml-base.bin",
      "resources/PACKAGING-NOTE.txt": "resources/PACKAGING-NOTE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
